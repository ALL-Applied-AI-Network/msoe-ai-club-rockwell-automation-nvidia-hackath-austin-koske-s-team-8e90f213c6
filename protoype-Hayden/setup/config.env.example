# Copy to setup/config.env and edit only what you need. Never commit credentials.
# Paths default to your own home, not Austin's account.
# export AI_CLUB_HOME="$HOME/ai-club-tools"
# On the shared Spark account, use your own name for separate output folders.
# export TEAM_MEMBER="cameron"
# export ROSIE_PYTORCH_SIF="/data/containers/msoe-pytorch-25.05-py3.sif"
# export COSMOS_MODEL="nvidia/Cosmos3-Edge"
# GB10 Isaac uses per-process setarch -R to avoid the observed Kit startup hang.
# Set this to 0 only when checking a newer runtime that fixes the hang.
# export ISAAC_DISABLE_ASLR=1
# An explicit revision is optional; the runner pins Edge and Nano separately.
# For hosted inference, export NVIDIA_API_KEY in your own shell.
# For gated models, use hf auth login in your own account.
