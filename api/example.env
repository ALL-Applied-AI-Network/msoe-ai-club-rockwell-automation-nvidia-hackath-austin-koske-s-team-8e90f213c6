APP__ENVIRONMENT__NAME=dev
APP__DATA_DIR=./data
APP__MODEL_WORKERS=1

# YOLO + Temporal CNN + measurement QA. Mock remains the safe default.
# APP__PIPELINE_MODE=model
# Released asset bundle (GB10 kit and Docker use this):
# APP__MODEL_ASSETS=/path/to/temporal-cnn-assets-v1
# APP__REFERENCE_IMAGE=/path/to/an-earlier-aligned-reference.png
# APP__DEVICE=cpu
# Or individual checkpoints; paths may be absolute or relative to the repository root:
# APP__YOLO_CHECKPOINT=integration/models/yolo_best.pt
# APP__TEMPORAL_CHECKPOINT=integration/models/liquid-best.pt
# APP__TEMPORAL_REFERENCE_IMAGE=integration/references/fillcam-1-empty.png
# Set true only after the aligned empty-vial reference has been independently reviewed.
# APP__TEMPORAL_REFERENCE_QUALIFIED=false
